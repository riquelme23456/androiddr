<?xml version="1.0" encoding="utf-8"?>

<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#2BBBAD">

    <!-- CABEÇALHO -->
    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="10dp"
        android:background="#1A8C7F">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/index_titulo"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:layout_centerVertical="true" />

        <ImageButton
            android:id="@+id/btnSairApp"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:padding="12dp"
            android:scaleType="fitCenter"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:src="@drawable/ic_sair"
            android:contentDescription="@string/index_cd_sair" />

    </RelativeLayout>

    <!-- CONTEÚDO -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            android:gravity="center">

            <!-- LOGO -->
            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="120dp"
                android:layout_height="120dp"
                android:src="@drawable/logomed"
                android:contentDescription="@string/index_cd_logo" />

            <!-- FOTO DA CLÍNICA -->
            <ImageView
                android:id="@+id/imgFoto"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:layout_marginTop="15dp"
                android:scaleType="centerCrop"
                android:src="@drawable/foto_clinica_1"
                android:contentDescription="@string/index_cd_foto" />

            <!-- BOTÃO LOGIN -->
            <Button
                android:id="@+id/btnIrLogin"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="25dp"
                android:text="@string/index_btn_login"
                android:textSize="16sp"
                android:backgroundTint="#2196F3" />

            <!-- BOTÃO CADASTRO -->
            <Button
                android:id="@+id/btnIrCadastro"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:text="@string/index_btn_cadastro"
                android:textSize="16sp"
                android:backgroundTint="#FFFFFF"
                android:textColor="#2BBBAD" />

            <!-- BOTÃO LOCALIZAÇÃO -->
            <Button
                android:id="@+id/btnVerEndereco"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="10dp"
                android:text="@string/index_btn_localizacao"
                android:textSize="16sp"
                android:backgroundTint="#FFC107"
                android:textColor="#000000"
                android:textStyle="bold" />

        </LinearLayout>

    </ScrollView>

    <!-- RODAPÉ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="#212529"
        android:padding="12dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/index_endereco"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:textSize="10sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/index_rodape"
            android:textColor="#888888"
            android:gravity="center"
            android:textSize="9sp"
            android:layout_marginTop="2dp" />

    </LinearLayout>

</LinearLayout>
